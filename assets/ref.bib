@article{antsys2025,
	title        = {Ant systematics: past, present, and future},
	author       = {Oberski, Jill T and Griebenow, Zachary H and Adams, Rachelle M M and Andersen, Alan and Andrade-Silva, Joudellys and Barden, Phillip and Borowiec, Marek and Brady, Se\'{a}n and Casadei-Ferreira, Alexandre and Cs\H{o}sz, S\'{a}ndor and Dias, Amanda Martins and Dias, Ratnayake Kaluarachchige Sriyani and Feitosa, Rodrigo Machado and Fernandez, Fernando and Fisher, Brian L and General, David Emmanuel M and Gomez, Kik\'{o} and Hammel, J\"{o}rg U and Hawkes, Peter G and Janda, Milan and Khalife, Adam and Ladino, Natalia and Lieberman, Ziv E and Lucky, Andrea and Menchetti, Mattia and Prado, L\'{\i}via Pires do and Prebus, Matthew M and Probst, Rodolfo S and Punnath, Aswaj and Richter, Adrian and Salata, Sebastian and S\'{a}nchez-Restrepo, Andr\'{e}s F and Schifani, Enrico and Schultz, Ted R and Silva, Rog\'{e}rio R and Sosa-Calvo, Jeffrey and Tocora, Maria C and Ulyss\'{e}a, M\^{o}nica Antunes and van de Kamp, Thomas and Wang, Wendy Y and Williams, Jason L and Camacho, Gabriela Procopio and Boudinot, Brendon E},
	year         = 2025,
	month        = {09},
	journal      = {Insect Systematics and Diversity},
	volume       = 9,
	number       = 4,
	pages        = 11,
	doi          = {10.1093/isd/ixaf025},
	issn         = {2399-3421},
	url          = {https://doi.org/10.1093/isd/ixaf025},
	abstract     = {The classification of ants (Hymenoptera: Formicidae) has progressed in waves since the first 17 species were described by Linnaeus in the 1758 edition of Systema Naturae. Since then, over 18,000 species-rank names have accumulated for the global myrmecofauna, of which \&sim;14,260 living and \&sim;810 fossil species are valid. Here, we provide a synopsis of ant biodiversity and review the history and classification of the family, while highlighting the massive growth of the field in the new millennium. We observe that major transformation has occurred for ant classification due to advances in DNA sequencing technologies, model-based hypothesis testing, and imaging technologies. We therefore provide a revised and illustrated list of diagnostic character states for the higher clades of Formicidae, recognizing that vastly more work is to be done. To facilitate discussion and the systematic accumulation of evolutionary knowledge for the early evolution of the ants, we suggest an informal nomenclatural system for the higher clades of ants, based on names currently in use and a set of names that have been democratically selected by the authors. To guide future work on ant systematics, we summarize currently available databases and present perspectives on regions in need of biodiversity exploration, challenges facing the field, and the future of ant taxonomy.},
	eprint       = {https://academic.oup.com/isd/article-pdf/9/4/11/64217267/ixaf025.pdf}
}
