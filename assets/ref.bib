@article{spandrels1,
	title        = {Evolutionary spandrels in collective animal behaviour},
	author       = {King, Andrew J. and Henry, Ella G. and Garnier, Simon and Allen, William L. and Heathcote, Robert J.P. and Fele, Marco and Papadopoulou, Marina and Sankey, Daniel W.E. and F{\"u}rtbauer, Ines},
	year         = 2026,
	month        = 8,
	journal      = {Trends in Ecology {\&} Evolution},
	publisher    = {Elsevier},
	doi          = {10.1016/j.tree.2026.07.011},
	issn         = {0169-5347},
	url          = {https://doi.org/10.1016/j.tree.2026.07.011},
	abstract     = {Collective behaviour is widespread in the animal kingdom and can enhance individual fitness. Yet not all collective behaviours are adaptations. Instead, some may be nonadaptive or 'evolutionary spandrels'—traits that originated as by-products in the sense proposed by Stephen Jay Gould and Richard Lewontin. Here, we argue that self-organising processes provide a route through which evolutionary spandrels in collective animal behaviour can occur, and we provide three examples: spatial organisation in primate groups, division of labour in ants, and insect chorusing. We then consider how such outcomes may be co-opted into adaptive roles through exaptation and conclude by outlining the challenges associated with testing adaptive and nonadaptive hypotheses in collective behaviour research using individual-based studies, phylogenetic comparative analyses, and agent-based models.}
}
@article{ghnlp5c1,
	title        = {Nest-Level Phase Transition Drives Synchronized Activity Bursts in Ant Colonies},
	author       = {Napoli, Michael and Garnier, Simon and Porfiri, Maurizio},
	year         = 2026,
	month        = {Aug},
	journal      = {PRX Life},
	publisher    = {American Physical Society},
	volume       = 4,
	pages        = {033010},
	doi          = {10.1103/ghnl-p5c1},
	url          = {https://link.aps.org/doi/10.1103/ghnl-p5c1},
	issue        = 3,
	numpages     = 15,
	abstract     = {Many natural complex systems exhibit synchronization, characterized by temporal coherence among the dynamics of their units. In ant colonies, synchronization manifests through activity bursts: sudden, sharp spikes of motion by a significant portion of workers throughout the nest, followed by durations of quiescence. These activity bursts were discovered three decades ago and studied since then; yet, the mechanisms that lead to their emergence remain elusive. Here, we present a model of ant activity that integrates both the motion of individuals within the nest and the transitions between behavioral states. By balancing microscopic behaviors in the model, we identify a nest-level phase transition from unsynchronized to synchronized activity and draw several connections between model predictions and empirical observations in the literature. Our analysis begets two key insights: (i) activity bursts emerge as a balance between the responsiveness of the colony to the first ant that activates and the ability of the colony to completely deactivate before the onset of the next burst, and (ii) the timescale of the motion of individuals through the nest is faster than that of the burst, suggesting that ants operate in a high-speed interaction regime where new behaviors are near-instantaneously transferred through the nest. We relate these findings to the broader literature on synchronization in complex systems, highlighting the need for periods of quiescence followed by the rapid communication of a new behavior through a population of connected units.}
}
@article{Bouju26,
	title        = {<i>Solenopsis</i> (Hymenoptera, Formicidae) thief ants in Dominican amber and putative subfossil resin},
	author       = {Valentine Bouju and Cédric Chény and Dietrich Gotzek and Vincent Perrichot and Fernando Fernandez and Phillip Barden and Gianpiero Fiorentino},
	year         = 2026,
	journal      = {Fossil Record},
	publisher    = {Pensoft Publishers},
	volume       = 29,
	number       = 2,
	pages        = {499--517},
	doi          = {10.3897/fr.29.181268},
	issn         = {2193-0066},
	url          = {https://doi.org/10.3897/fr.29.181268},
	abstract     = {<i>Solenopsis</i> is a diverse genus of myrmicine ants with a global distribution. Several extinct species have been described but these occurrences are limited to the Palaearctic as imprint fossils. Wilson (1985, 1988) mentioned specimens of <i>Solenopsis</i> preserved in Dominican amber (Middle Miocene, ca. 16 Ma), though these have not been formally described. Through ethanol exposure and Raman spectroscopy, we assessed the provenance of several putative amber specimens in museum collections. We identified multiple instances of labeled amber specimens that are instead most likely subfossil copal or recent resin – these include specimens in a historical collection. Based on material with provenance and properties consistent with fossil resin, or, amber, we report five new fossil species of minor workers attributed to the genus <i>Solenopsis</i>: <i>S. lamellata</i> sp. nov., <i>S. pilonaria</i> sp. nov., <i>S. merengue</i> sp. nov., <i>S. viralata</i> sp. nov., and <i>S. picapica</i> sp. nov. One of the species described, <i>S. lamellata</i> sp. nov., is highly aberrant, possessing a spine-like lamella on the posterior margin of the propodeum, a trait not shared with any known <i>Solenopsis</i> species. The discovery of these five fossil species sheds light on the biogeographic history of the genus <i>Solenopsis</i>. Beyond ants, these results highlight the need for caution in assuming the provenance of specimens from museum collections and commercial sources.},
	eprint       = {https://doi.org/10.3897/fr.29.181268}
}
@unpublished{capobianco2026databaseddynamicalsystemsreconstruction,
	title        = {Data-Based Dynamical Systems Reconstruction: An Adequacy/Reliability Test},
	author       = {Guillermo Capobianco and Ulises Chialva and Horacio G. Rotstein},
	year         = 2026,
	url          = {https://arxiv.org/abs/2606.24873},
	eprint       = {2606.24873},
	archiveprefix = {arXiv},
	primaryclass = {math-ph},
	abstract     = {In this work, we address the problem of validating the reconstruction of a stochastic system from noisy data. We demonstrate the limitations of criteria based solely on the loss function or on standard metrics used for reconstructing deterministic dynamics. We also propose an exploratory approach, based on a two-step test, which allows for a general assessment of the reconstruction without relying on arbitrary error-tolerance thresholds. However, we discuss how system degeneracy and non-identifiability, together with features intrinsic to stochastic dynamics, impose certain constraints on the application of this test.)}
}
@article{hr20261,
	title        = {Integration between the knowledge diaspora and their country of origin through institutional affiliations: a case study for policy development},
	author       = {Rotstein, Horacio G. G.},
	year         = 2026,
	journal      = {Frontiers in Research Metrics and Analytics},
	volume       = {Volume 11 - 2026},
	doi          = {10.3389/frma.2026.1852906},
	issn         = {2504-0537},
	url          = {https://www.frontiersin.org/journals/research-metrics-and-analytics/articles/10.3389/frma.2026.1852906},
	abstract     = {The knowledge economy is fundamentally driven by human capital, making the “brain drain” phenomenon a critical challenge for national development. Traditionally, policy frameworks have focused on repatriation, circulation or vinculation to address this issue. However, these models often fail to account for more regular and permanent institutional associations between the diaspora of knowledge professionals (KPs) and the science, technology and innovation (STI) institutions of their country of origin (CO). Such associations are increasingly feasibly due to technological advances that render many STI activities independent of geography. This paper advances the notion of KP diaspora integration within the domestic STI institutions of their CO, incorporating a framework focused on structural institutional membership. We provide an in depth analysis and propose a blueprint for policy development aimed at achieving this goal. We use Argentina as a case study for several reasons, including its well-developed STI system, its comparatively large KP diaspora, and its history of KP diaspora organization and interaction with the Argentine STI system. The proposed policy framework opens avenues for the development of specific policies at the institutional level tailored to the unique characteristics, local constraints and goals of each organization. The ideas, core principles, and policy blueprint we present have a broader generality and are applicable mutatis mutandis to other developing countries experiencing the brain drain phenomenon.}
}
@article{ixag027,
	title        = {Ants (Hymenoptera: Formicidae) preserved in amber shed light on faunal turnover and ecological roles before the end-Cretaceous extinction},
	author       = {Loewen, Elyssa J T and Libke, Caelan and Sosiak, Christine and Barden, Phillip and Somers, Christopher and McKellar, Ryan C},
	year         = 2026,
	month        = {07},
	journal      = {Insect Systematics and Diversity},
	volume       = 10,
	number       = 4,
	doi          = {10.1093/isd/ixag027},
	issn         = {2399-3421},
	url          = {https://doi.org/10.1093/isd/ixag027},
	abstract     = {Substantial gaps in the ant fossil record surrounding the end-Cretaceous mass extinction have obscured the timing of early crown ant radiations and their palaeoecological diversity. Here, we describe two partial fossil ants (Formicidae: Pseudomyrmecinae; Formicidae: Aneuretinae) from Late Cretaceous Big Muddy amber (∼67.04 Ma). These are the oldest definitive representatives of Aneuretinae and Pseudomyrmecinae, extending their fossil records back into the Late Cretaceous and expanding their known spatiotemporal ranges. We used a broad extant ecomorphological dataset to evaluate the accuracy of Random Forest machine-learning classification for predicting the palaeoecology of partial ant fossils and to compare the inferred ecological niches of the Big Muddy ants and their respective extinct Cenozoic consubfamilials with those of their extant close relatives. We show that even with a limited subset of morphological traits, Random Forest models can generate accurate ecological predictions; however, model reliability is significantly impacted by the exclusion of sensory traits and the presence of flexible ecology. The Big Muddy pseudomyrmecine was recovered as terricolous, in contrast to the arboreal ecology of its Cenozoic and extant relatives, suggesting the transition to arboreal habitats may have occurred after the end-Cretaceous mass extinction. While the Big Muddy aneruetine results were not robust, its Cenozoic relatives were also reconstructed as terricolous and were more ecologically diverse than their sole living relative, the relictual <i>Aneuretus simoni</i> Emery, 1893. The presence of these subfamilies in Big Muddy amber supports the hypothesized timing of a major radiation of ecologically and taxonomically diverse crown ant subfamilies in the Late Cretaceous alongside flowering plants.},
	eprint       = {https://academic.oup.com/isd/article-pdf/10/4/ixag027/68759171/ixag027.pdf}
}
@article{HYLANDBRUNO2026111111,
	title        = {Assessing the Role of Vocal Plasticity in Sociospatial Coordination},
	author       = {Hyland Bruno, Julia and Eduardo Mercado},
	year         = 2026,
	journal      = {Animals},
	volume       = 16,
	number       = 6,
	pages        = 890,
	doi          = {https://doi.org/10.3390/ani16060890},
	url          = {https://www.mdpi.com/2076-2615/16/6/890},
	keywords     = {active sensing, auditory plasticity, cetacean, communication, spatial hearing, sound localization, vocal learning, vocal interaction},
	abstract     = {Studies of vocal communication often focus on the messages that calls and songs convey related to reproductive activities, foraging, predator avoidance, social bonding, individual recognition, and conflict resolution. We consider ways in which vocalizations may dynamically mediate social interactions at a more basic level, through collective coordination of movements and the enhancement of spatial perception. From this perspective, animals may vocalize to probe the locations, movements, and intentions of others, to manipulate position changes by listeners, or to increase their own capacity to localize sounds. An animal's capacity to flexibly adjust vocalizations, both in real-time and over longer periods, can increase their ability to monitor and influence conspecifics independently of any information that may be encoded within those vocalizations. Beyond simply conveying messages, reproductive fitness, or emotional states, an animal's ability to modulate vocalizations may dynamically affect its future action plans and social roles within a group. Identifying situational, life-history, and sociospatial factors that determine how animals vocally interact in real-time is key to understanding how an animal's vocalizations relate to its own actions and the actions of others.}
}
@article{HYLANDBRUNO2026123458,
	title        = {Vocal interactions between singing humpback whales, <i>Megaptera novaeangliae</i>},
	author       = {Hyland Bruno, Julia and Eduardo Mercado and Niko Tietjen and Isabel Levin and Mary Ryan},
	year         = 2026,
	journal      = {Animal Behaviour},
	volume       = 234,
	pages        = 123458,
	doi          = {https://doi.org/10.1016/j.anbehav.2025.123458},
	issn         = {0003-3472},
	url          = {https://www.sciencedirect.com/science/article/pii/S0003347225003859},
	keywords     = {acoustic monitoring, bioacoustics, cetacean, communication, masking interference, song, vocal production, whale song},
	abstract     = {Humpback whales construct predictably patterned sequences within multihour sessions of sound production. These sequences (called 'songs') are some of the most structurally and acoustically complex vocal patterns produced by any mammal. Humpback whale song production is highly dynamic in that individuals constantly modify the properties of songs across multiple timescales throughout their adult lives. Past analyses of co-vocalizing humpback whales suggest that singers within earshot of one another may dynamically and interactively adjust their vocalizations in reaction to what they hear. The current study investigated whether singing humpback whales coordinate their production of concurrent songs either by overlapping similar sound patterns more than expected by chance or by modulating the spectral properties of sound sequences, thereby decreasing acoustic interference. Our results show that the vocal adjustments co-singing humpback whales make are diverse and appear to depend on the acoustic context. No evidence was found of singers adjusting the number or timing of sound pattern repetitions to alter pattern overlap. In contrast, most singers modified the spectral features of sound patterns after a second singer began singing. Co-singers appeared to intermittently alter produced pitches in reaction to each other’s vocal actions, suggesting that singing humpbacks attend to other audible singers and may sometimes alter song content to initiate social interactions from long distances. Understanding how and when singing whales vocally interact can provide new insights into the various roles singing plays in coordinating vertebrate behaviour.}
}
@article{Fiorentino2026,
	title        = {The ant genus <i>Hypoponera</i> (Hymenoptera: Formicidae) in Dominican amber},
	author       = {Fiorentino, Gianpiero and Bouju, Valentine and Sosa, Diyael and Navarro, Santo and Barden, Phillip},
	year         = 2026,
	journal      = {Journal of Paleontology},
	pages        = {1–5},
	doi          = {10.1017/jpa.2025.10213},
	abstract     = {<i>Hypoponera</i> Santschi, 1938 is a genus of ponerine ants, well known for its simplified morphology, lacking any clear autopomorphy, and its cosmopolitan distribution. Here, we describe the first <i>Hypoponera</i> in Dominican amber. The discovery of <i>Hypoponera electrocacica</i> new species confirms the long-expected presence of the genus in the Caribbean Miocene. The modern diversity of <i>Hypoponera</i> in the Greater Antilles now stands at five species and two putative subspecies.}
}
@article{Nogueira2026,
	title        = {Honeypots: a review of repletism across the ants},
	author       = {Nogueira, Bianca R and LeBoeuf, Adria C and Barden, Phillip and Nguyen, Diem Quynh V and Khadempour, Lily},
	year         = 2026,
	journal      = {Myrmecological News},
	publisher    = {The Austrian Society of Entomofaunistics},
	volume       = 36,
	pages        = {39--57},
	doi          = {10.25849/MYRMECOL.NEWS_036:039},
	url          = {https://myrmecologicalnews.org/cms/index.php?option=com_content&view=category&id=1667&Itemid=444},
	abstract     = {Honeypot ants are a fascinating case of the convergent evolution of an internal food storage strategy. They are characterized by a subset of physogastric workers, called repletes, that store food long-term in their crops to support the colony in times of low resource availability. Despite their biological and evolutionary significance, information on honeypot ants remains scattered, and the trait itself has lacked a clear and unified definition. This review synthesizes current knowledge on replete morphology, physiology, and function, establishing a foundation for defining the repletism syndrome. Through our literature review, we confirm the occurrence of repletes in at least eight genera across three subfamilies (Formicinae, Dolichoderinae, and Myrmicinae). We also identify four genera with putative honeypot species that remain poorly studied, and clarify cases of misidentification, where repletism has been confused with other internal storage strategies such as worker corpulence, trophic eggs, or thoracic crop expansion. We propose that repletism occurs along a spectrum across species, reflecting both morphological specialization and behavioral flexibility. In this review, we also demonstrate the global distribution of this extreme adaptation. Finally, we highlight future research directions into factors driving convergence of repletism, and mechanisms and potential microbial interactions underlying this adaptation.}
}
@article{RN4354,
	title        = {High-Pass Filtering through Short-Term Synaptic Facilitation Amplifies Low-Frequency Modulation of Bursting Input},
	author       = {Bucher, Dirk M. and Daur, Nelly and Varughese, Abigail and Schneider, Anna C. and Nadim, Farzan},
	year         = 2026,
	journal      = {The Journal of Neuroscience},
	volume       = 46,
	number       = 3,
	pages        = {e1652252025},
	doi          = {10.1523/jneurosci.1652-25.2025},
	url          = {https://www.jneurosci.org/content/jneuro/46/3/e1652252025.full.pdf},
	abstract     = {Regular rhythmic activity typically produces stereotypical synaptic responses, masking dynamics due to short-term synaptic plasticity (STP). Multiple-frequency (e.g., Poisson-like) inputs unveil canonical STP effects where facilitation or depression, respectively, favor high- or low-frequency inputs, and a mix of both favors intermediate frequencies. Notably, regular activity with multiple oscillatory components can produce synaptic responses that are not readily surmisable from canonical STP responses. In the responses of rhythmically activated muscles of the lobster (Homarus americanus), of either sex, slow modulation of bursting inputs, consisting of periodic changes in burst frequency and spike number, is amplified by dynamic neuromuscular synapses. Using a simple STP model, we demonstrate that facilitation enhances the difference (contrast) in responses to strong and weak bursts, while depression diminishes it. Nonintuitively, such changes in contrast imply that high-pass filtering enhances low-frequency components of the modulated bursting, whereas low-pass filtering attenuates them. For mixtures of facilitation and depression, our modeling results suggest a complex dependence of the readout of slow modulation on overall release probability and recovery times for vesicle depletion and calcium accumulation. Notably, these effects are reduced when the recovery time of STP exceeds the burst period and thereby allows a memory of prior activity across consecutive bursts. Additionally, with memory across bursts, response contrast does not change proportionally with input contrast and depends on the number of bursts per slow modulation cycle. Finally, a biophysical model of a postsynaptic cell demonstrates that simple subthreshold voltage-gated conductances can substantially contribute to the readout of low-frequency modulation.},
	type         = {Journal Article}
}
@article{syag005,
	title        = {Soaring Systematics: an evaluation of biogeography and flight behavior in dragonflies and damselflies (Insecta: Odonata) using phylogenomics},
	author       = {Newton, Lacie G and Abbott, John C and Bybee, Seth M and Carter, Payton and Frandsen, Paul B and Goodman, Aaron and Guralnick, Robert and Hahn, Brittney and Idec, Jacob and Kalkman, Vincent J and Kolhi, Manpreet and Fomekong-Lontchi, Judica\"{e}l and Lupiyanigdyah, Pungki and Onsongo, Violet and Rowe, Emma and Sanchez-Herrera, Melissa and Pinkert, Stefan and Sutherland, Laura and Tolman, Ethan and Uche-Dike, Rhema and Barden, Phil and Belitz, Michael and Bota-Sierra, Cornelio A and Cordero-Rivera, Adolfo and C\'{o}rdoba-Aguilar, Alex and Dijkstra, Klaas-Douwe B and Dow, Rory A and Ehlert, Juliana and Ferreira, Rhainer G and H\"{a}m\"{a}l\"{a}inen, Matti and Juen, Leandro and Lorenzo-Carballa, M Olalla and Mauffray, Bill and Nielsen, Anne L and Pessacq, Pablo and Pham, Thai Hong and Pinto, \^{A}ngelo Parise and Richards, Stephen J and Salas, Ruth and Skevington, Jeffrey H and Theischinger, Gunther and Zhang, Haomiao and Ware, Jessica L},
	year         = 2026,
	month        = {01},
	journal      = {Systematic Biology},
	pages        = {syag005},
	doi          = {10.1093/sysbio/syag005},
	issn         = {1063-5157},
	url          = {https://doi.org/10.1093/sysbio/syag005},
	abstract     = {Dragonflies and damselflies (Insecta: Odonata) are descended from what were most likely the first winged animals, which flew \&sim;320 million years ago (Ma). They comprise \&sim;6400 extant species distributed across all continents except Antarctica. Examination of long-standing hypotheses regarding the role of flight behavior and wing morphology in shaping the global distribution of odonates has been limited by spatial and taxonomic scope. Here we leverage mobilized trait and distribution data derived from specimens and literature combined with a uniquely comprehensive target-enriched phylogeny (\&sim;940 loci) covering all families and 67\&percnt; of recognized genera. Ancestral state reconstruction of flight behavior strategies ("flyer" vs. "percher") suggests the odonate ancestor was a flyer, spending a majority of its time when active on the wing, with multiple independent transitions to percher. Several transitions back to the flyer behavior have also occurred. Aspect ratios for forewings and hindwings showed a strong relationship between these traits and perching and flying behavioral strategies. Divergence time estimation suggests the crown age of Odonata to be 290–325 Ma. Bayesian biogeographical evolutionary analysis of nine biogeographical realms provides a preliminary biogeographical history for odonates spanning 325 Ma. Key family-level splits occurred during the Jurassic and Cretaceous, paralleling the increasing isolation of landmasses and the poleward drift of the contemporary Australasian and Holarctic regions. Both behavioral and morphological adaptations likely facilitated the distributional success of select odonate lineages. This study lays the foundation for a revised classification of odonates and a more complete understanding of the influence of flight behavior and wing morphology in relation to evolutionary processes shaping past and current odonate diversity.},
	eprint       = {https://academic.oup.com/sysbio/advance-article-pdf/doi/10.1093/sysbio/syag005/66537766/syag005.pdf}
}
